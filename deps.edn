{:paths ["src" "resources"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.5"}

  ;; hive-ingestor — the host this addon extends: ISource, the source and
  ;; parser-rule registries, and the document pipeline everything feeds.
  io.github.hive-agi/hive-ingestor {:mvn/version "0.2.83"}

  ;; hive-dsl — Result monad and error taxonomy
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.15"}

  ;; hive-addon — the IAddon protocol this registers through
  io.github.hive-agi/hive-addon {:mvn/version "0.3.4"}

  ;; Logging
  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                io.github.hive-agi/hive-test  {:mvn/version "0.3.12"}
                org.clojure/test.check        {:mvn/version "1.1.3"}}
   :main-opts ["-m" "kaocha.runner"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.3.12"}
                org.clojure/test.check       {:mvn/version "1.1.3"}}}

  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.9"}}
   :ns-default hive-build.api}}}
